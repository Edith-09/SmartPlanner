# These client-side API keys are included in the app bundle. Restrict them in each
# provider console to the app's Android package/SHA-1 and iOS bundle identifier.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_TOMTOM_API_KEY=

# Override service endpoints for alternate environments or a future proxy.
EXPO_PUBLIC_GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com/directions/v2
EXPO_PUBLIC_GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
EXPO_PUBLIC_TOMTOM_TRAFFIC_BASE_URL=https://api.tomtom.com/traffic/services/5
