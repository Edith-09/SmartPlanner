{
  "expo": {
    "name": "Smart Transport Planner",
    "slug": "smart-transport-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smart-transport-planner",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
  "supportsTablet": true,
  "bundleIdentifier": "com.henry.smarttransportplanner",
  "infoPlist": {
    "NSLocationWhenInUseUsageDescription": "Smart Transport Planner uses your location to set a trip origin and find nearby traffic reports."
  }
},
    "android": {
      "package": "com.henry.smarttransportplanner",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/smarttransport.png",
        "backgroundImage": "./assets/smarttransport.png",
        "monochromeImage": "./assets/smarttransport.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Smart Transport Planner to use your location to set a trip origin and find nearby traffic reports."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1a19efd6-bc2c-4d62-b028-90e9f53b0b19"
      }
    },
    "owner": "devherry"
  }
}
